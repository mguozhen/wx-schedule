# Anthropic API — for vision parsing of WeChat screenshots
ANTHROPIC_API_KEY=sk-ant-xxx

# Gmail SMTP — generate an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mguozhen@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Hunter Shu

# Your local timezone (IANA name)
MY_TZ=Asia/Shanghai
MY_NAME=Hunter Shu
MY_EMAIL=mguozhen@gmail.com

# DingTalk Calendar via MCP — get the Streamable HTTP URL from
# https://mcp.dingtalk.com/ → 钉钉日程/日历 MCP → "获取 MCP Server 配置"
# Example: https://mcp-streamable.dingtalk.com/sse?token=xxx
DINGTALK_CALENDAR_MCP_URL=

# Path to mcporter binary (defaults to ~/.bun/bin/mcporter installed via `bun i -g mcporter`)
MCPORTER_BIN=/Users/hunter/.bun/bin/mcporter
